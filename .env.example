# --- Database ---------------------------------------------------------------
# SQLite for dev. For production, swap the provider in prisma/schema.prisma to
# postgresql and use a Postgres connection string here (see docs/DEPLOYMENT.md).
DATABASE_URL="file:./dev.db"

# --- Sessions ----------------------------------------------------------------
# Signs the session cookie. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# --- Seed (optional) ----------------------------------------------------------
# The seed script creates an admin account with these credentials.
# If you skip seeding, the app walks you through creating the first
# administrator at /setup on first run.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-me-now"
